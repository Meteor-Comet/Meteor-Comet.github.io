---
// MermaidRenderer component
---

<script>
let mermaidModule: typeof import("mermaid") | null = null;
let renderPromise: Promise<void> | null = null;

async function renderMermaid(force = false) {
	const elements = document.querySelectorAll<HTMLElement>(".mermaid");
	if (elements.length === 0) return;

	try {
		if (!mermaidModule) {
			mermaidModule = await import("mermaid");
		}
		const mermaid = mermaidModule.default;

		const isDark = document.documentElement.classList.contains("dark");
		mermaid.initialize({
			startOnLoad: false,
			theme: isDark ? "dark" : "default",
			securityLevel: "loose",
			fontFamily: "inherit",
		});

		if (force) {
			for (const el of elements) {
				const rawCode = el.getAttribute("data-code");
				if (rawCode) {
					el.removeAttribute("data-processed");
					el.textContent = rawCode;
				}
			}
		}

		const pendingNodes = Array.from(
			document.querySelectorAll<HTMLElement>(".mermaid:not([data-processed='true'])")
		);
		if (pendingNodes.length > 0) {
			await mermaid.run({
				nodes: pendingNodes,
			});
		}
	} catch (err) {
		console.error("Mermaid execution error:", err);
	}
}

function safeRenderMermaid(force = false) {
	if (renderPromise) {
		renderPromise = renderPromise.then(() => renderMermaid(force));
	} else {
		renderPromise = renderMermaid(force).finally(() => {
			renderPromise = null;
		});
	}
}

const setupMermaid = () => {
	safeRenderMermaid();
	window.swup?.hooks?.on("page:view", () => {
		safeRenderMermaid();
	});
};

if (window.swup) {
	setupMermaid();
} else {
	document.addEventListener("swup:enable", setupMermaid);
	safeRenderMermaid();
}

let lastThemeIsDark = document.documentElement.classList.contains("dark");
const themeObserver = new MutationObserver(() => {
	const currentThemeIsDark = document.documentElement.classList.contains("dark");
	if (currentThemeIsDark !== lastThemeIsDark) {
		lastThemeIsDark = currentThemeIsDark;
		safeRenderMermaid(true);
	}
});
themeObserver.observe(document.documentElement, {
	attributes: true,
	attributeFilter: ["class"],
});
</script>
