---
import { Icon } from "astro-icon/components";
import { getPostUrlBySlug } from "../../utils/url-utils";

interface SeriesPost {
	slug: string;
	data: {
		title: string;
		seriesOrder?: number;
		series_order?: number;
	};
}

interface Props {
	series: string;
	prevPost: SeriesPost | null;
	nextPost: SeriesPost | null;
	currentIndex: number;
	totalCount: number;
}

const { series, prevPost, nextPost, currentIndex, totalCount } = Astro.props;
---

<div class="my-8 p-4 md:p-5 rounded-2xl bg-black/[0.02] dark:bg-white/[0.03] border border-black/10 dark:border-white/10">
    <div class="flex items-center justify-between mb-3.5 pb-2.5 border-b border-black/5 dark:border-white/5">
        <div class="flex items-center gap-2 text-sm font-bold text-black/80 dark:text-white/80">
            <Icon name="material-symbols:bookmark-manager-rounded" class="text-[var(--primary)] text-lg" />
            <span>专栏目录导航 · {series}</span>
        </div>
        <span class="text-xs px-2 py-0.5 rounded bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 font-medium">
            {currentIndex + 1} / {totalCount}
        </span>
    </div>

    <div class="flex flex-col sm:flex-row gap-3">
        <!-- 上一篇 -->
        {prevPost ? (
            <a
                href={getPostUrlBySlug(prevPost.slug)}
                class="btn-card flex-1 p-3.5 rounded-xl border border-black/5 dark:border-white/5 hover:border-[var(--primary)]/30 flex flex-col items-start gap-1 group transition"
            >
                <div class="text-xs font-semibold text-[var(--primary)] flex items-center gap-1">
                    <Icon name="material-symbols:chevron-left-rounded" class="text-lg -ml-1 group-hover:-translate-x-0.5 transition-transform" />
                    <span>上一篇 · 第 {currentIndex} 篇</span>
                </div>
                <div class="text-sm font-bold text-black/80 dark:text-white/80 group-hover:text-[var(--primary)] transition line-clamp-1 w-full text-left">
                    {prevPost.data.title}
                </div>
            </a>
        ) : (
            <div class="flex-1 p-3.5 rounded-xl border border-dashed border-black/10 dark:border-white/10 opacity-40 flex flex-col items-start gap-1 select-none">
                <span class="text-xs text-black/50 dark:text-white/50">专栏起始篇</span>
                <span class="text-sm font-medium text-black/60 dark:text-white/60">第一篇内容</span>
            </div>
        )}

        <!-- 下一篇 -->
        {nextPost ? (
            <a
                href={getPostUrlBySlug(nextPost.slug)}
                class="btn-card flex-1 p-3.5 rounded-xl border border-black/5 dark:border-white/5 hover:border-[var(--primary)]/30 flex flex-col items-end gap-1 group transition"
            >
                <div class="text-xs font-semibold text-[var(--primary)] flex items-center gap-1">
                    <span>下一篇 · 第 {currentIndex + 2} 篇</span>
                    <Icon name="material-symbols:chevron-right-rounded" class="text-lg -mr-1 group-hover:translate-x-0.5 transition-transform" />
                </div>
                <div class="text-sm font-bold text-black/80 dark:text-white/80 group-hover:text-[var(--primary)] transition line-clamp-1 w-full text-right">
                    {nextPost.data.title}
                </div>
            </a>
        ) : (
            <div class="flex-1 p-3.5 rounded-xl border border-dashed border-black/10 dark:border-white/10 opacity-40 flex flex-col items-end gap-1 select-none">
                <span class="text-xs text-black/50 dark:text-white/50">专栏结束篇</span>
                <span class="text-sm font-medium text-black/60 dark:text-white/60">🎉 本专栏已完结</span>
            </div>
        )}
    </div>
</div>
