---
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import SeriesBanner from "@components/misc/SeriesBanner.astro";
import SeriesNav from "@components/misc/SeriesNav.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts, getSecretPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig, secretConfig } from "src/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	const secretEntries = await getSecretPosts();
	const combinedMap = new Map();
	[...blogEntries, ...secretEntries].forEach((entry) => combinedMap.set(entry.slug, entry));
	const allEntries = Array.from(combinedMap.values());

	return allEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry, allPosts: allEntries },
	}));
}

const { entry, allPosts: propPosts } = Astro.props;
const allPosts = propPosts || (await getSortedPosts());

const seriesName = entry.data.series;
let seriesPosts: typeof allPosts = [];
let currentSeriesIndex = -1;
let prevSeriesPost: (typeof allPosts)[0] | null = null;
let nextSeriesPost: (typeof allPosts)[0] | null = null;

if (seriesName) {
	seriesPosts = allPosts
		.filter((p) => p.data.series === seriesName && (import.meta.env.PROD ? p.data.draft !== true : true))
		.sort((a, b) => {
			const orderA = a.data.seriesOrder ?? a.data.series_order ?? 999;
			const orderB = b.data.seriesOrder ?? b.data.series_order ?? 999;
			if (orderA !== orderB) return orderA - orderB;
			return new Date(a.data.published).getTime() - new Date(b.data.published).getTime();
		});

	currentSeriesIndex = seriesPosts.findIndex((p) => p.slug === entry.slug);
	if (currentSeriesIndex > 0) {
		prevSeriesPost = seriesPosts[currentSeriesIndex - 1];
	}
	if (currentSeriesIndex >= 0 && currentSeriesIndex < seriesPosts.length - 1) {
		nextSeriesPost = seriesPosts[currentSeriesIndex + 1];
	}
}

const { Content, headings } = await entry.render();
const { remarkPluginFrontmatter } = await entry.render();

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};

const date_str = formatDateToYYYYMMDD(entry.data.published);
const disqus_identifier = "/" + date_str.replace(/-/g, "/") + "/" + entry.slug;
const disqus_url = "https://meteor-comet.github.io/posts/" + entry.slug + "/";
const isSecret = entry.data.secret === true;
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    {isSecret && <meta slot="head" name="robots" content="noindex, nofollow" />}
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" {...(isSecret ? { "data-pagefind-ignore": "all" } : {})} class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
            {}
        ]}>
            <!-- word count and reading time -->
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <div
                    {...(!isSecret ? { "data-pagefind-body": true, "data-pagefind-weight": "10", "data-pagefind-meta": "title" } : {})}
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.data.title}
                </div>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getDir(entry.id))} class="mb-8 rounded-xl banner-container onload-animation"/>
            }


            {seriesName && seriesPosts.length > 0 && (
                <SeriesBanner series={seriesName} seriesPosts={seriesPosts} currentSlug={entry.slug} />
            )}

            {isSecret && (
                <div id="secret-lock-container" class="my-8 p-8 card-base text-center max-w-md mx-auto border border-[var(--primary)]/20 shadow-lg onload-animation">
                    <div class="w-14 h-14 rounded-2xl bg-[var(--primary)]/10 text-[var(--primary)] flex items-center justify-center mx-auto mb-4 text-2xl">
                        🔒
                    </div>
                    <h3 class="text-xl font-bold text-black/90 dark:text-white/90 mb-2">本文为私密内容</h3>
                    <p class="text-sm text-black/50 dark:text-white/50 mb-5 leading-relaxed">请输入访问密码以阅读全文</p>
                    <div class="space-y-3">
                        <input
                            id="secret-password-input"
                            type="password"
                            placeholder="请输入访问密码..."
                            class="w-full px-4 py-2.5 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-black/90 dark:text-white/90 focus:outline-none focus:ring-2 focus:ring-[var(--primary)] text-center tracking-wider transition"
                        />
                        <div id="secret-error-msg" class="text-xs text-red-500 font-medium hidden">
                            密码错误，请重新输入
                        </div>
                        <button
                            id="secret-unlock-btn"
                            class="w-full py-2.5 px-6 rounded-xl bg-[var(--primary)] text-white font-semibold shadow hover:opacity-90 active:scale-[0.98] transition cursor-pointer"
                        >
                            解 锁 阅 读
                        </button>
                    </div>
                </div>
            )}

            <div id="secret-content-wrapper" class={isSecret ? "hidden" : ""}>
                <Markdown class="mb-6 markdown-content onload-animation">
                    <Content />
                </Markdown>
            </div>

            {seriesName && seriesPosts.length > 0 && (
                <SeriesNav
                    series={seriesName}
                    prevPost={prevSeriesPost}
                    nextPost={nextSeriesPost}
                    currentIndex={currentSeriesIndex}
                    totalCount={seriesPosts.length}
                />
            )}

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>

    <!-- Disqus Comments Card (仅公开文章展示) -->
    {!isSecret && (
        <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4 onload-animation">
            <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
                <div id="disqus_thread"></div>
            </div>
        </div>

        <script is:inline define:vars={{ disqus_identifier, disqus_url }}>
            var disqus_config = function () {
                this.page.url = disqus_url;
                this.page.identifier = disqus_identifier;
            };
            (function() {
                var d = document, s = d.createElement('script');
                s.src = 'https://comet-blog-1.disqus.com/embed.js';
                s.setAttribute('data-timestamp', +new Date());
                (d.head || d.body).appendChild(s);
            })();
        </script>
    )}

    {isSecret && (
        <script is:inline define:vars={{ expectedPassword: secretConfig.password }}>
            (function() {
                const STORAGE_KEY = 'blog_secret_unlocked';
                const lockContainer = document.getElementById('secret-lock-container');
                const contentWrapper = document.getElementById('secret-content-wrapper');
                const passwordInput = document.getElementById('secret-password-input');
                const unlockBtn = document.getElementById('secret-unlock-btn');
                const errorMsg = document.getElementById('secret-error-msg');

                function unlock() {
                    if (lockContainer) lockContainer.style.display = 'none';
                    if (contentWrapper) {
                        contentWrapper.classList.remove('hidden');
                        contentWrapper.style.display = 'block';
                    }
                }

                if (localStorage.getItem(STORAGE_KEY) === 'true') {
                    unlock();
                }

                if (unlockBtn && passwordInput) {
                    function tryUnlock() {
                        if (passwordInput.value.trim() === expectedPassword.trim()) {
                            localStorage.setItem(STORAGE_KEY, 'true');
                            if (errorMsg) errorMsg.classList.add('hidden');
                            unlock();
                        } else {
                            if (errorMsg) errorMsg.classList.remove('hidden');
                            passwordInput.focus();
                        }
                    }

                    unlockBtn.addEventListener('click', tryUnlock);
                    passwordInput.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            tryUnlock();
                        }
                    });
                }
            })();
        </script>
    )}

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.nextSlug}]}>
            {entry.data.nextSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.prevSlug}]}>
            {entry.data.prevSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
            </div>}
        </a>
    </div>

</MainGridLayout>
