---
import SecretPanel from "@components/SecretPanel.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { secretConfig } from "../config";
import { getSecretPostsList } from "../utils/content-utils";

const secretPostsList = await getSecretPostsList();
---

<MainGridLayout title={secretConfig.name} description={secretConfig.description}>
    <SecretPanel
        sortedPosts={secretPostsList}
        correctPassword={secretConfig.password}
        title={secretConfig.title}
        description={secretConfig.description}
        client:only="svelte"
    />
</MainGridLayout>
